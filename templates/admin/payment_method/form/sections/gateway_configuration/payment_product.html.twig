        {% include '@SyliusHiPayPlugin/admin/payment_method/form/sections/gateway_configuration/_payment_product_select.html.twig' with {
            field: form.payment_product,
            hidden_value_test_attr: 'gateway-config-payment-product-value',
        } only %}
    </div>
{% endif %}
