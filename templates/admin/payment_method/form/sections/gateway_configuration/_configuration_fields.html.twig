{# ===== Remaining fields (future payment methods) ===== #}
{% set handled_fields = [
    'capture_mode',
    'allowed_countries', 'allowed_currencies', 'minimum_amount', 'maximum_amount',
    'allowed_brands', 'one_click_enabled', 'three_ds_mode',
    'supported_networks', 'display_name', 'button_type', 'button_color',
        'multi_browser', 'display_mode', 'only_active_card', 'merchant_identifier',
    'text_color', 'placeholder_color', 'icon_color',
    'invalid_text_color', 'valid_text_color',
    'oneclick_highlight_color', 'save_button_color',
    'font_family', 'font_size', 'font_style', 'font_weight', 'text_decoration',
    'expiration_limit',
    'promotion_code',
    'can_pay_later', 'button_shape', 'button_label', 'button_height'
] %}
{% set has_remaining = false %}
{% for child in config %}
    {% if child.vars.name not in handled_fields %}
        {% set has_remaining = true %}
    {% endif %}
{% endfor %}

{% if has_remaining %}
    {% embed '@SyliusHiPayPlugin/admin/payment_method/form/sections/gateway_configuration/_collapsible_card.html.twig' with {
        id: id_prefix ~ '-additional-settings',
        title: 'sylius_hipay_plugin.form.configuration.section.additional_settings'|trans,
        icon: 'bi-sliders',
        expanded: false,
    } %}
        {% block body %}
            <div class="row">
                {% for child in config %}
                    {% if child.vars.name not in handled_fields %}
                        <div class="col-12 col-md-6">
                            {{ form_row(child) }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        {% endblock %}
    {% endembed %}
{% endif %}
